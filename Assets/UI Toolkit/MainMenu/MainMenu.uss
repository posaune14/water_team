.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
    transition: all 0.1s ease-in-out;
    -unity-font-definition: url("project://database/Assets/Daydream%20DEMO.otf?fileID=12800000&guid=66c3bbaaacba3ab48a309962c4dbcd6e&type=3#Daydream DEMO");
}

.custom-label:hover {
    color: rgb(248, 234, 174);
    -unity-font-definition: url("project://database/Assets/Daydream%20DEMO.otf?fileID=12800000&guid=66c3bbaaacba3ab48a309962c4dbcd6e&type=3#Daydream DEMO");
}

.root {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    margin-left: 24px;
}

.main-menu {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
